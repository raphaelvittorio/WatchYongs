// Prisma schema — WatchYoung repair order system

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Counter {
  id    String @id
  value Int    @default(0)
}

// MASTER: akses penuh (laporan, export, backup, kelola staff, hapus data).
// STAFF: hanya bagian operasional (order, customer, foto, WhatsApp).
enum Role {
  MASTER
  STAFF
}

// Cabang toko. id sengaja string tetap ("golden8", "hampton") supaya mudah
// dibaca di SQL. Prefix menentukan format nomor order/invoice cabang itu.
model Branch {
  id            String        @id
  name          String
  orderPrefix   String        @unique
  invoicePrefix String        @unique
  address       String?
  phone         String?
  createdAt     DateTime      @default(now())
  users         User[]
  customers     Customer[]
  orders        RepairOrder[]
  invoices      Invoice[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  // Wajib untuk STAFF (dicek di API), selalu null untuk MASTER.
  branchId     String?
  branch       Branch?  @relation(fields: [branchId], references: [id])
  createdAt    DateTime @default(now())

  @@index([branchId])
}

model Customer {
  id             String        @id @default(cuid())
  name           String
  phone          String
  email          String?
  address        String?
  ownerAge       Int?
  ownerCharacter String?
  // Cabang asal: tempat customer pertama kali didaftarkan. Data customer
  // dipakai bersama semua cabang; ini hanya menentukan daftar default.
  branchId       String
  branch         Branch        @relation(fields: [branchId], references: [id])
  createdAt      DateTime      @default(now())
  orders         RepairOrder[]

  @@index([branchId])
}

enum OrderStatus {
  INTAKE
  ASSESSMENT
  ONPROCESS
  COMPLETED
  PICKED
  REJECTED
}

enum ServiceType {
  BESAR
  KECIL
}

model RepairOrder {
  id              String          @id @default(cuid())
  orderNumber     String          @unique
  branchId        String
  branch          Branch          @relation(fields: [branchId], references: [id])
  customerId      String
  customer        Customer        @relation(fields: [customerId], references: [id])
  watchBrand      String
  watchModel      String?
  watchInfo       String?
  serviceType     ServiceType?
  status          OrderStatus     @default(INTAKE)
  notes           String?
  statusChangedAt DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  photos          Photo[]
  statusHistory   StatusHistory[]
  assessment      Assessment?
  invoiceId       String?
  invoice         Invoice?        @relation(fields: [invoiceId], references: [id])
  invoiceItems    InvoiceItem[]
  whatsappLogs    WhatsappLog[]

  @@index([branchId])
}

enum PhotoStage {
  INTAKE
  ASSESSMENT
  COMPLETION
}

model Photo {
  id            String      @id @default(cuid())
  repairOrderId String
  repairOrder   RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  stage         PhotoStage
  path          String
  uploadedAt    DateTime    @default(now())
}

model StatusHistory {
  id            String       @id @default(cuid())
  repairOrderId String
  repairOrder   RepairOrder  @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  fromStatus    OrderStatus?
  toStatus      OrderStatus
  note          String?
  changedAt     DateTime     @default(now())
}

enum AssessmentDecision {
  PENDING
  APPROVED
  REJECTED
}

model Assessment {
  id             String             @id @default(cuid())
  repairOrderId  String             @unique
  repairOrder    RepairOrder        @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  estimatedPrice Int
  diagnosis      String?
  decision       AssessmentDecision @default(PENDING)
  decidedAt      DateTime?
  createdAt      DateTime           @default(now())
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  branchId      String
  branch        Branch        @relation(fields: [branchId], references: [id])
  amount        Int
  note          String?
  pdfPath       String
  createdAt     DateTime      @default(now())
  items         InvoiceItem[]
  orders        RepairOrder[]

  @@index([branchId])
}

model InvoiceItem {
  id            String       @id @default(cuid())
  invoiceId     String
  invoice       Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  repairOrderId String?
  repairOrder   RepairOrder? @relation(fields: [repairOrderId], references: [id])
  description   String
  amount        Int
  sortOrder     Int          @default(0)
}

model WhatsappLog {
  id            String      @id @default(cuid())
  repairOrderId String
  repairOrder   RepairOrder @relation(fields: [repairOrderId], references: [id], onDelete: Cascade)
  templateType  String
  message       String
  sentAt        DateTime    @default(now())
}
